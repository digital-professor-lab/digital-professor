# Copy to .env and keep real keys local (never commit .env).
# Only needed for HOSTED providers — local Ollama needs nothing here.

# Name a key here, then point config at it with `api_key_env: <VAR>` (or --api-key-env).
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# JHU_API_KEY=

# Optional overrides (take precedence over config.yaml, below CLI flags):
# COURSE_CONTEXT_BASE_URL=http://localhost:11434/v1
# COURSE_CONTEXT_MODEL=qwen3:8b
# COURSE_CONTEXT_API_KEY_ENV=OPENAI_API_KEY
