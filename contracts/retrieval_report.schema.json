{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:entagile:retrieval-report:1.1",
  "title": "Retrieval report 1.1",
  "type": "object",
  "required": [
    "schema_version",
    "question",
    "status",
    "message",
    "not_found_reason",
    "scope_assessment",
    "evidence_assessment",
    "results",
    "context",
    "retrieval_queries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "found",
        "not_found",
        "needs_clarification"
      ]
    },
    "message": {
      "type": "string"
    },
    "not_found_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "context": {
      "type": "string"
    },
    "retrieval_queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_assessment": {
      "type": "object",
      "required": [
        "status",
        "next_action"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_assessed",
            "no_selected_evidence"
          ]
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "scope_assessment": {
      "type": "object",
      "required": [
        "policy_version",
        "decision",
        "category",
        "reason_code",
        "requested_scopes",
        "allowed_scopes",
        "required_source_types",
        "available_source_types",
        "matched_rules",
        "next_action",
        "explanation"
      ],
      "properties": {
        "policy_version": {
          "const": "2"
        },
        "decision": {
          "enum": [
            "retrieve",
            "not_found",
            "needs_clarification"
          ]
        },
        "category": {
          "enum": [
            "within_selected_scope",
            "out_of_scope",
            "mixed_scope",
            "filter_conflict",
            "ambiguous_scope",
            "source_unavailable"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_source_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "available_source_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "matched_text"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "matched_text": {
                "type": "string"
              }
            }
          }
        },
        "next_action": {
          "enum": [
            "retrieve",
            "clarify_scope",
            "change_scope",
            "confirm_scope",
            "request_source"
          ]
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "citation",
          "passage_id",
          "filename",
          "line_start",
          "line_end",
          "score",
          "signals",
          "raw_latex"
        ],
        "properties": {
          "citation": {
            "type": "string"
          },
          "passage_id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "score": {
            "type": "number",
            "description": "Fusion ranking value, not confidence or probability."
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "raw_latex": {
            "type": "string",
            "minLength": 1
          },
          "query_matches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "found"
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 1
          },
          "context": {
            "minLength": 1
          },
          "not_found_reason": {
            "type": "null"
          },
          "scope_assessment": {
            "properties": {
              "decision": {
                "const": "retrieve"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "results": {
            "maxItems": 0
          },
          "context": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_found"
          }
        }
      },
      "then": {
        "properties": {
          "not_found_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        }
      },
      "then": {
        "properties": {
          "not_found_reason": {
            "type": "null"
          },
          "scope_assessment": {
            "properties": {
              "decision": {
                "const": "needs_clarification"
              }
            }
          }
        }
      }
    }
  ]
}
