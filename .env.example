# OpenAI-compatible tutoring provider. Copy this file to .env.
DIGITAL_PROFESSOR_PROVIDER=openai
DIGITAL_PROFESSOR_MODEL=gpt-4.1-mini
DIGITAL_PROFESSOR_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=

# Optional pricing inputs for estimated per-request cost in logs. Update these
# when provider pricing changes. Values are USD per one million tokens.
DIGITAL_PROFESSOR_INPUT_COST_PER_MILLION=
DIGITAL_PROFESSOR_OUTPUT_COST_PER_MILLION=

# Vision model used for handwriting OCR.
OPENAI_HANDWRITING_MODEL=gpt-4o-mini
OPENAI_HANDWRITING_INPUT_COST_PER_MILLION=
OPENAI_HANDWRITING_OUTPUT_COST_PER_MILLION=

# Set for another OpenAI-compatible provider; leave unset for OpenAI.
# DIGITAL_PROFESSOR_BASE_URL=https://api.openai.com/v1
