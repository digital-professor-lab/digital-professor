# Digital Professor configuration. Copy this file to .env and fill in a key.
# .env is git-ignored: never commit real keys. Restart the backend after editing.
# Every setting is explained in docs/notes/CONFIGURATION.md.

# ---------------------------------------------------------------------------
# 1. Tutoring model (required for model-written replies)
# ---------------------------------------------------------------------------
# Supported profiles: openrouter, deepseek, anthropic, openai, ollama, custom.
# The default below is DeepSeek V4.1 Flash through OpenRouter: the same model
# DeepSeek's own API serves as `deepseek-chat`. One OpenRouter key also covers
# the Jev passage judge (section 3) and, optionally, handwriting (section 2).
DIGITAL_PROFESSOR_PROVIDER=openrouter
DIGITAL_PROFESSOR_MODEL=deepseek/deepseek-v4.1-flash-1017

# Keys for several providers can sit here together; the Provider settings page
# in the demo switches between them. Fill in at least the one selected above.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DIGITAL_PROFESSOR_API_KEY=

# The startup profile selects its key variable automatically. This optional
# override is useful for a custom deployment.
# DIGITAL_PROFESSOR_API_KEY_ENV=OPENROUTER_API_KEY

# Optional per-provider endpoint, e.g. a company-hosted DeepSeek deployment:
# DEEPSEEK_BASE_URL=
# OPENROUTER_BASE_URL=
# ANTHROPIC_BASE_URL=
# Or override the selected profile's endpoint directly. Ollama defaults to
# http://127.0.0.1:11434/v1 and does not require a key.
# DIGITAL_PROFESSOR_BASE_URL=

# Optional pricing inputs for estimated per-request cost in logs, in USD per
# one million tokens. Update them when provider pricing changes.
DIGITAL_PROFESSOR_INPUT_COST_PER_MILLION=
DIGITAL_PROFESSOR_OUTPUT_COST_PER_MILLION=

# ---------------------------------------------------------------------------
# 2. Handwriting recognition (optional)
# ---------------------------------------------------------------------------
# A vision model that supports image input and structured output. It is called
# through the OpenAI client, so it uses OPENAI_API_KEY (and OPENAI_BASE_URL).
DIGITAL_PROFESSOR_HANDWRITING_MODEL=gpt-4o-mini
DIGITAL_PROFESSOR_HANDWRITING_INPUT_COST_PER_MILLION=
DIGITAL_PROFESSOR_HANDWRITING_OUTPUT_COST_PER_MILLION=
# To run handwriting through OpenRouter instead of OpenAI: set the model above
# to openai/gpt-4o-mini, paste the OpenRouter key into OPENAI_API_KEY, and
# uncomment the next line. It also sends the `openai` tutoring profile to OpenRouter.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# 3. Jev passage judge (optional; on when OPENROUTER_API_KEY is set)
# ---------------------------------------------------------------------------
# Jev scores candidate textbook passages before the tutor cites one. Only
# textbook text is sent. Set DP_JEV=off to use the built-in rules only.
# DP_JEV=off
# JEV_MODEL=typesafe/jev-1.13
# DP_JEV_CACHE=.cache/jev/jev_answers.jsonl

# ---------------------------------------------------------------------------
# 4. Course material and retrieval (optional)
# ---------------------------------------------------------------------------
# auto (default): Retrieval V1 when installed, else the keyword index | tool | keyword
# DP_RETRIEVAL_MODE=auto
# Limit the embedding models, e.g. bge_base_en_v1_5 (default: BGE and Qwen).
# DP_RETRIEVAL_MODELS=
# A Week 3 knowledge_base folder whose downloaded models should be reused.
# WEEK3_KB=
# Ingest only the textbook sections the syllabus lists (off by default).
# DP_TEXTBOOK_SCOPE=on
# Restore published courses after a restart (local development only).
# DP_KEEP_COURSES=1

# ---------------------------------------------------------------------------
# 5. Tutoring Engine switches (for experiments; leave unset normally)
# ---------------------------------------------------------------------------
# Turn off the guard model (the code checks still run):
# DIGITAL_PROFESSOR_REPLY_GUARD=0
# Stop the Engine from searching the course material:
# DIGITAL_PROFESSOR_ENGINE_RETRIEVAL=0
# Folder for run logs (default: logs):
# DIGITAL_PROFESSOR_LOG_DIR=logs
