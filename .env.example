# Provider and exact model/version identifier. Copy this file to .env.
# Supported profiles: openai, openrouter, deepseek, ollama, custom.
DIGITAL_PROFESSOR_PROVIDER=openai
DIGITAL_PROFESSOR_MODEL=gpt-4.1-mini
# The startup profile selects its key variable automatically. This optional
# override is useful for a custom deployment.
# DIGITAL_PROFESSOR_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DIGITAL_PROFESSOR_API_KEY=

# Optional pricing inputs for estimated per-request cost in logs. Update these
# when provider pricing changes. Values are USD per one million tokens.
DIGITAL_PROFESSOR_INPUT_COST_PER_MILLION=
DIGITAL_PROFESSOR_OUTPUT_COST_PER_MILLION=

# Vision model used for handwriting OCR. The selected provider/model must
# support image input and Responses-style structured output.
DIGITAL_PROFESSOR_HANDWRITING_MODEL=gpt-4o-mini
DIGITAL_PROFESSOR_HANDWRITING_INPUT_COST_PER_MILLION=
DIGITAL_PROFESSOR_HANDWRITING_OUTPUT_COST_PER_MILLION=

# Override the profile endpoint if needed. Ollama defaults to
# http://127.0.0.1:11434/v1 and does not require a key.
# DIGITAL_PROFESSOR_BASE_URL=https://api.openai.com/v1
