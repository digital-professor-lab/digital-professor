%% Course Knowledge Retrieval: the four touchpoints (rag-retrieval.md §2)
flowchart LR
    subgraph Setup["Course provisioning (before students)"]
        CC["Course Context Stage A<br/>syllabus → CourseContext"] --> ING["Ingestion Stage B<br/>notes / textbook → IngestedSource"]
        ING -->|"T1 IngestedSource"| IDX["Retrieval: chunk, index,<br/>validate, coverage"]
        IDX -->|"RetrievalIndexStatus"| PUB["Publish course release<br/>(retrieval_snapshot_id)"]
    end
    subgraph QS["Question establishment"]
        QB["QuestionSchema builder"] -->|"T2 CourseContextLookupRequest"| LK["Retrieval: bank match / concept match"]
        LK -->|"CourseContextLookupResult"| QB
    end
    subgraph Turn["Tutoring turn"]
        RQ["Tutoring Engine (proposed)<br/>or Interaction coordinator"] -->|"T3 RetrievalRequest"| RET["Retrieval: validate → gate → plan →<br/>search → select → resolve → sufficiency"]
        RET -->|"GroundingBundle / RetrievalStop"| ENG["Tutoring Engine"]
        ENG -->|"TutoringAction.grounding_refs"| DEL["Delivery"]
        DEL -->|"T4 resolve / verify"| RES["Retrieval: citation resolution"]
    end
    PUB --> LK
    PUB --> RET
    RET -.->|"InteractionTraceEvent"| TR[("Session State and Trace")]
    RET -.->|"RetrievalReport (diagnostics on)"| EV[("Evaluation")]
