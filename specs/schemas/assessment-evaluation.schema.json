{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-professor-lab.github.io/schemas/assessment-evaluation.schema.json",
  "title": "AssessmentEvaluation",
  "description": "A non-binary, source-grounded evaluation of confirmed StudentEvidence (assessment.md section 6.3).",
  "x-schema-version": "0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "record_type", "schema_version", "created_at", "producer", "status", "correlation_id", "evaluation_id", "assessment_session_id", "assessment_question_id", "question_id", "attempt_id", "evidence_id", "correctness_score", "dimension_results", "correct_elements", "partial_elements", "incorrect_elements", "omitted_elements", "feedback_latex", "grounding_refs", "response_time_ms", "timing_quality", "review_status", "limitations", "evaluator_version"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"const": "AssessmentEvaluation"},
    "schema_version": {"const": "0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "insufficient_evidence", "insufficient_grounding", "review_required", "failed"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "assessment_session_id": {"type": "string", "minLength": 1},
    "assessment_question_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "correctness_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "dimension_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "weight", "earned", "status", "explanation", "grounding_refs"],
        "properties": {
          "dimension": {"enum": ["concept", "method", "execution", "communication"]},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "earned": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "status": {"enum": ["correct", "partial", "incorrect", "omitted", "not_applicable", "insufficient_evidence"]},
          "explanation": {"type": "string", "minLength": 1, "maxLength": 3000},
          "grounding_refs": {"type": "array", "items": {"$ref": "#/$defs/NoteGroundingRef"}}
        }
      }
    },
    "correct_elements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "partial_elements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "incorrect_elements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "omitted_elements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "feedback_latex": {"type": "string", "minLength": 1, "maxLength": 10000},
    "grounding_refs": {"type": "array", "items": {"$ref": "#/$defs/NoteGroundingRef"}},
    "response_time_ms": {"type": ["integer", "null"], "minimum": 0},
    "timing_quality": {"enum": ["valid", "interrupted", "unknown"]},
    "review_status": {"enum": ["not_required", "recommended", "required"]},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evaluator_version": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "correctness_score": {"type": "number", "minimum": 0, "maximum": 1},
          "dimension_results": {"minItems": 1},
          "grounding_refs": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"timing_quality": {"enum": ["interrupted", "unknown"]}}, "required": ["timing_quality"]},
      "then": {"properties": {"response_time_ms": {"type": ["integer", "null"], "minimum": 0}}}
    }
  ],
  "$defs": {
    "NoteGroundingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passage_id", "document_id", "source_type", "content_version", "page_number", "line_start", "line_end", "highlight_url"],
      "properties": {
        "passage_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "source_type": {"const": "lecture_notes"},
        "content_version": {"type": "string", "minLength": 1},
        "page_number": {"type": "integer", "minimum": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "highlight_url": {"type": "string", "minLength": 1}
      }
    }
  }
}
