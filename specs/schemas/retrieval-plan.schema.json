{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetrievalPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "course_id",
    "concepts",
    "concept_status",
    "main_query",
    "needs",
    "scope",
    "origin",
    "repairs"
  ],
  "properties": {
    "plan_version": {
      "const": "retrieval-plan@2"
    },
    "course_id": {
      "type": "string",
      "minLength": 1
    },
    "concepts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "name",
          "module_id",
          "source",
          "role"
        ],
        "properties": {
          "concept_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "module_id": {
            "type": "string"
          },
          "source": {
            "enum": [
              "question_schema",
              "linked",
              "model"
            ]
          },
          "role": {
            "enum": [
              "primary",
              "related"
            ]
          }
        }
      }
    },
    "concept_status": {
      "enum": [
        "found",
        "none_found",
        "not_in_course"
      ]
    },
    "main_query": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "needs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "need_id",
          "need_type",
          "query",
          "preferred_blocks"
        ],
        "properties": {
          "need_id": {
            "pattern": "^n[1-4]$"
          },
          "need_type": {
            "enum": [
              "formula_statement",
              "definition",
              "theorem_statement",
              "worked_example",
              "exercise",
              "method_guidance",
              "prerequisite_explanation",
              "notation_convention",
              "course_policy"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "anchor": {
            "type": "string",
            "maxLength": 80
          },
          "concept_id": {
            "type": "string"
          },
          "preferred_blocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "module_ids",
        "narrowing"
      ],
      "properties": {
        "module_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "narrowing": {
          "enum": [
            "not_enforced",
            "module",
            "section"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "origin": {
      "enum": [
        "draft",
        "model"
      ]
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "code"
        ]
      }
    },
    "linking": {
      "type": "object"
    }
  }
}
