{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-professor-lab.github.io/schemas/assessment-session.schema.json",
  "title": "AssessmentSession",
  "description": "State for one adaptive, one-question-at-a-time assessment session (assessment.md section 6.1).",
  "x-schema-version": "0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "record_type", "schema_version", "created_at", "producer", "status", "correlation_id", "assessment_session_id", "course_id", "session_id", "user_id", "allowed_question_types", "target_scope", "current_difficulty", "active_question_id", "completed_question_ids", "course_context_version", "retrieval_snapshot_id"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"const": "AssessmentSession"},
    "schema_version": {"const": "0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "active", "awaiting_rating", "paused", "complete", "failed"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "assessment_session_id": {"type": "string", "minLength": 1},
    "course_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "allowed_question_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["multiple_choice", "true_false", "open_ended"]}
    },
    "target_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_type", "concept_ids", "objective_ids"],
      "properties": {
        "scope_type": {"enum": ["course", "concepts", "objectives"]},
        "concept_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "objective_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "current_difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
    "active_question_id": {"type": ["string", "null"], "minLength": 1},
    "completed_question_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "course_context_version": {"type": "string", "minLength": 1},
    "retrieval_snapshot_id": {"type": "string", "minLength": 1},
    "question_count_goal": {"type": ["integer", "null"], "minimum": 1},
    "paused_reason": {"type": ["string", "null"], "maxLength": 500}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["active", "awaiting_rating"]}}},
      "then": {"properties": {"active_question_id": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["ready", "complete"]}}},
      "then": {"properties": {"active_question_id": {"type": "null"}}}
    }
  ]
}
