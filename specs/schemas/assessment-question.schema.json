{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-professor-lab.github.io/schemas/assessment-question.schema.json",
  "title": "AssessmentQuestion",
  "description": "A generated, validated, frozen assessment question and its restricted answer material (assessment.md section 6.2).",
  "x-schema-version": "0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "record_type", "schema_version", "created_at", "producer", "status", "correlation_id", "assessment_question_id", "assessment_session_id", "question_id", "attempt_id", "course_id", "concept_ids", "objective_ids", "difficulty_level", "question_type", "prompt_latex", "choices", "answer_key", "rubric", "grounding_refs", "content_versions", "retrieval_snapshot_id"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"const": "AssessmentQuestion"},
    "schema_version": {"const": "0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "validated", "active", "answered", "evaluated", "closed", "invalid"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "assessment_question_id": {"type": "string", "minLength": 1},
    "assessment_session_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "course_id": {"type": "string", "minLength": 1},
    "concept_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "objective_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "difficulty_level": {"type": "integer", "minimum": 1, "maximum": 5},
    "question_type": {"enum": ["multiple_choice", "true_false", "open_ended"]},
    "prompt_latex": {"type": "string", "minLength": 1, "maxLength": 10000},
    "choices": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["choice_id", "content_latex"],
        "properties": {
          "choice_id": {"type": "string", "minLength": 1},
          "content_latex": {"type": "string", "minLength": 1, "maxLength": 3000}
        }
      }
    },
    "answer_key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correct_choice_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "correct_boolean": {"type": "boolean"},
        "expected_answer_latex": {"type": "string", "minLength": 1},
        "required_elements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "acceptable_equivalents": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "anyOf": [
        {"required": ["correct_choice_ids"]},
        {"required": ["correct_boolean"]},
        {"required": ["expected_answer_latex", "required_elements"]}
      ]
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_version", "dimensions"],
      "properties": {
        "rubric_version": {"type": "string", "minLength": 1},
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "weight", "criteria", "critical"],
            "properties": {
              "dimension": {"enum": ["concept", "method", "execution", "communication"]},
              "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "criteria": {"type": "string", "minLength": 1, "maxLength": 2000},
              "critical": {"type": "boolean"}
            }
          }
        }
      }
    },
    "distractor_rationales": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["choice_id", "rationale"],
        "properties": {
          "choice_id": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "grounding_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/NoteGroundingRef"}},
    "content_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "retrieval_snapshot_id": {"type": "string", "minLength": 1},
    "expected_time_ms": {"type": ["integer", "null"], "minimum": 1000},
    "presented_at": {"type": ["string", "null"], "format": "date-time"},
    "validation_failures": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"question_type": {"const": "multiple_choice"}}, "required": ["question_type"]},
      "then": {
        "properties": {
          "choices": {"minItems": 2, "maxItems": 5},
          "answer_key": {"required": ["correct_choice_ids"]}
        }
      }
    },
    {
      "if": {"properties": {"question_type": {"const": "true_false"}}, "required": ["question_type"]},
      "then": {
        "properties": {
          "choices": {"maxItems": 0},
          "answer_key": {"required": ["correct_boolean", "required_elements"]}
        }
      }
    },
    {
      "if": {"properties": {"question_type": {"const": "open_ended"}}, "required": ["question_type"]},
      "then": {
        "properties": {
          "choices": {"maxItems": 0},
          "answer_key": {"required": ["expected_answer_latex", "required_elements"]}
        }
      }
    }
  ],
  "$defs": {
    "NoteGroundingRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passage_id", "document_id", "source_type", "content_version", "page_number", "line_start", "line_end", "highlight_url"],
      "properties": {
        "passage_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "source_type": {"const": "lecture_notes"},
        "content_version": {"type": "string", "minLength": 1},
        "page_number": {"type": "integer", "minimum": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "highlight_url": {"type": "string", "minLength": 1}
      }
    }
  }
}
